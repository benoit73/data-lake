<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>charger_fait_bilan</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Une ligne par bilan (SIREN, date de clôture, type de bilan).</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>64</height>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <note>Charge les bilans nettoyés. Le ratio d'impôt (HK / FL) n'est pas stocké : il se calcule à la lecture (vue v_ratio_impot), parce qu'un ratio ne s'additionne pas.</note>
      <width>760</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Lire les bilans (DuckDB)</from>
      <to>fait_bilan</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Lire les bilans (DuckDB)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>duckdb</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT siren, date_cloture::DATE AS date_cloture, type_bilan, confidentialite,
       chiffre_affaires, impot_benefices
FROM read_parquet('s3://processed/hop/bilans.snappy.parquet')</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>64</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>fait_bilan</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dw</connection>
    <schema>public</schema>
    <table>fait_bilan</table>
    <commit>10000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>siren</column_name>
        <stream_name>siren</stream_name>
      </field>
      <field>
        <column_name>date_cloture</column_name>
        <stream_name>date_cloture</stream_name>
      </field>
      <field>
        <column_name>type_bilan</column_name>
        <stream_name>type_bilan</stream_name>
      </field>
      <field>
        <column_name>confidentialite</column_name>
        <stream_name>confidentialite</stream_name>
      </field>
      <field>
        <column_name>chiffre_affaires</column_name>
        <stream_name>chiffre_affaires</stream_name>
      </field>
      <field>
        <column_name>impot_benefices</column_name>
        <stream_name>impot_benefices</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
