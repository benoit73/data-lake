<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>charger_dim_temps</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Un jour par ligne, du 01/01/2000 au 31/12/2030.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>64</height>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <note>Génère le calendrier : date de départ + n jours, puis année, trimestre et mois.</note>
      <width>760</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>11 323 jours</from>
      <to>Numéro du jour</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Numéro du jour</from>
      <to>Date, année, trimestre, mois</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Date, année, trimestre, mois</from>
      <to>dim_temps</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>11 323 jours</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <format>yyyy-MM-dd</format>
        <group/>
        <length>-1</length>
        <name>debut</name>
        <nullif>2000-01-01</nullif>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>Date</type>
      </field>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>11323</limit>
    <never_ending>N</never_ending>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>64</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Numéro du jour</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <use_counter>Y</use_counter>
    <use_database>N</use_database>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <seqname>SEQ_</seqname>
    <start_at>0</start_at>
    <valuename>n</valuename>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Date, année, trimestre, mois</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <calculation>
      <calc_type>ADD_DAYS</calc_type>
      <field_a>debut</field_a>
      <field_b>n</field_b>
      <field_c/>
      <field_name>jour</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Date</value_type>
    </calculation>
    <calculation>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_a>jour</field_a>
      <field_b></field_b>
      <field_c/>
      <field_name>annee</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>QUARTER_OF_DATE</calc_type>
      <field_a>jour</field_a>
      <field_b></field_b>
      <field_c/>
      <field_name>trimestre</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>MONTH_OF_DATE</calc_type>
      <field_a>jour</field_a>
      <field_b></field_b>
      <field_c/>
      <field_name>mois</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <failIfNoFile>Y</failIfNoFile>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>dim_temps</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dw</connection>
    <schema>public</schema>
    <table>dim_temps</table>
    <commit>10000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>jour</column_name>
        <stream_name>jour</stream_name>
      </field>
      <field>
        <column_name>annee</column_name>
        <stream_name>annee</stream_name>
      </field>
      <field>
        <column_name>trimestre</column_name>
        <stream_name>trimestre</stream_name>
      </field>
      <field>
        <column_name>mois</column_name>
        <stream_name>mois</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
