<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>nettoyer_annonces</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Créations et radiations BODACC : avis initiaux, SIREN, type de personne.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>64</height>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <note>Lit tous les fichiers BODACC du bucket raw (radiations + une année de créations par fichier) via DuckDB, garde les avis initiaux (pas les rectificatifs ni les annulations), extrait le SIREN de « registre » et le type de personne (pm = société, pp = personne physique) de « listepersonnes ».</note>
      <width>760</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Lire les annonces (DuckDB)</from>
      <to>Avis initiaux</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Avis initiaux</from>
      <to>Registre sans espaces</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Registre sans espaces</from>
      <to>Extraire le SIREN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Extraire le SIREN</from>
      <to>Extraire le type de personne</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Extraire le type de personne</from>
      <to>Colonnes du data warehouse</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes du data warehouse</from>
      <to>Écrire processed/hop/annonces</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Lire les annonces (DuckDB)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>duckdb</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT id, dateparution, typeavis, familleavis, numerodepartement, departement_nom_officiel,
       region_code, region_nom_officiel, registre, listepersonnes
FROM read_parquet('s3://raw/annonces-commerciales_*.parquet')</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Avis initiaux</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
          <negated>N</negated>
          <operator>-</operator>
          <leftvalue>typeavis</leftvalue>
          <function>=</function>
          <rightvalue/>
          <value>
            <name>constant</name>
            <type>String</type>
            <text>annonce</text>
            <length>-1</length>
            <precision>-1</precision>
            <isnull>N</isnull>
            <mask></mask>
          </value>
        </condition>
    </compare>
    <send_true_to/>
    <send_false_to/>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Registre sans espaces</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>registre</in_stream_name>
        <out_stream_name>registre_compact</out_stream_name>
        <use_regex>N</use_regex>
        <replace_string> </replace_string>
        <replace_by_string></replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>N</whole_word>
        <case_sensitive>N</case_sensitive>
        <is_unicode>N</is_unicode>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Extraire le SIREN</name>
    <type>RegexEval</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <script>(\d{9}).*</script>
    <matcher>registre_compact</matcher>
    <resultfieldname>siren_trouve</resultfieldname>
    <usevar>N</usevar>
    <allowcapturegroups>Y</allowcapturegroups>
    <replacefields>N</replacefields>
    <canoneq>N</canoneq>
    <caseinsensitive>N</caseinsensitive>
    <comment>N</comment>
    <dotall>N</dotall>
    <multiline>N</multiline>
    <unicode>N</unicode>
    <unix>N</unix>
    <fields>
      <field>
        <name>siren</name>
        <type>String</type>
        <format/>
        <group/>
        <decimal/>
        <currency/>
        <length>-1</length>
        <precision>-1</precision>
        <nullif/>
        <ifnull/>
        <trimtype>none</trimtype>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Extraire le type de personne</name>
    <type>RegexEval</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <script>.*?"typePersonne": ?"(p[mp])".*</script>
    <matcher>listepersonnes</matcher>
    <resultfieldname>type_trouve</resultfieldname>
    <usevar>N</usevar>
    <allowcapturegroups>Y</allowcapturegroups>
    <replacefields>N</replacefields>
    <canoneq>N</canoneq>
    <caseinsensitive>N</caseinsensitive>
    <comment>N</comment>
    <dotall>Y</dotall>
    <multiline>N</multiline>
    <unicode>N</unicode>
    <unix>N</unix>
    <fields>
      <field>
        <name>type_personne</name>
        <type>String</type>
        <format/>
        <group/>
        <decimal/>
        <currency/>
        <length>-1</length>
        <precision>-1</precision>
        <nullif/>
        <ifnull/>
        <trimtype>none</trimtype>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Colonnes du data warehouse</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>id</name>
        <rename>annonce_id</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>familleavis</name>
        <rename>type_annonce</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>dateparution</name>
        <rename>jour</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>numerodepartement</name>
        <rename>departement_code</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>departement_nom_officiel</name>
        <rename>departement_nom</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>region_code</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>region_nom_officiel</name>
        <rename>region_nom</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>siren</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>type_personne</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1024</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Écrire processed/hop/annonces</name>
    <type>ParquetFileOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compression_codec>SNAPPY</compression_codec>
    <data_page_size>1048576</data_page_size>
    <dictionary_page_size>1048576</dictionary_page_size>
    <fields>
      <field>
        <source_field>annonce_id</source_field>
        <target_field>annonce_id</target_field>
      </field>
      <field>
        <source_field>type_annonce</source_field>
        <target_field>type_annonce</target_field>
      </field>
      <field>
        <source_field>jour</source_field>
        <target_field>jour</target_field>
      </field>
      <field>
        <source_field>departement_code</source_field>
        <target_field>departement_code</target_field>
      </field>
      <field>
        <source_field>departement_nom</source_field>
        <target_field>departement_nom</target_field>
      </field>
      <field>
        <source_field>region_code</source_field>
        <target_field>region_code</target_field>
      </field>
      <field>
        <source_field>region_nom</source_field>
        <target_field>region_nom</target_field>
      </field>
      <field>
        <source_field>siren</source_field>
        <target_field>siren</target_field>
      </field>
      <field>
        <source_field>type_personne</source_field>
        <target_field>type_personne</target_field>
      </field>
    </fields>
    <filename_base>garage://processed/hop/annonces</filename_base>
    <filename_create_parent_folders>Y</filename_create_parent_folders>
    <filename_compression_before_extension>Y</filename_compression_before_extension>
    <filename_datetime_format>yyyyMMdd-HHmmss</filename_datetime_format>
    <filename_ext>parquet</filename_ext>
    <filename_include_copy>N</filename_include_copy>
    <filename_include_date>N</filename_include_date>
    <filename_include_datetime>N</filename_include_datetime>
    <filename_include_split>N</filename_include_split>
    <filename_include_time>N</filename_include_time>
    <filename_split_size>0</filename_split_size>
    <row_group_size>134217728</row_group_size>
    <version>2.0</version>
    <attributes/>
    <GUI>
      <xloc>1184</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
