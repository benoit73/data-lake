<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>charger_dim_departement</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Liste des départements et de leur région, tirée des annonces.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>64</height>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <note>Dédoublonne les départements présents dans les annonces nettoyées.</note>
      <width>760</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Lire les annonces (DuckDB)</from>
      <to>Département renseigné</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Département renseigné</from>
      <to>Un par département</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Un par département</from>
      <to>dim_departement</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Lire les annonces (DuckDB)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>duckdb</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT departement_code, departement_nom, region_code, region_nom
FROM read_parquet('s3://processed/hop/annonces.snappy.parquet')</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>64</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Département renseigné</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
          <negated>N</negated>
          <operator>-</operator>
          <leftvalue>departement_code</leftvalue>
          <function>IS NOT NULL</function>
          <rightvalue/>
          
        </condition>
    </compare>
    <send_true_to/>
    <send_false_to/>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Un par département</name>
    <type>UniqueRowsByHashSet</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>departement_code</name>
      </field>
    </fields>
    <reject_duplicate_row>N</reject_duplicate_row>
    <store_values>Y</store_values>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>dim_departement</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dw</connection>
    <schema>public</schema>
    <table>dim_departement</table>
    <commit>10000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>departement_code</column_name>
        <stream_name>departement_code</stream_name>
      </field>
      <field>
        <column_name>departement_nom</column_name>
        <stream_name>departement_nom</stream_name>
      </field>
      <field>
        <column_name>region_code</column_name>
        <stream_name>region_code</stream_name>
      </field>
      <field>
        <column_name>region_nom</column_name>
        <stream_name>region_nom</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>640</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
